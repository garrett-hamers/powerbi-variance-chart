{
  "name": "atlyn-variance-chart",
  "description": "Open-source variance analysis visual for Microsoft Power BI.",
  "version": "1.8.2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/garrett-hamers/powerbi-variance-chart.git"
  },
  "license": "MIT",
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "package": "pbiviz package --certification-audit",
    "audit": "npm audit --audit-level=moderate",
    "eslint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint": "npm run eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "certify": "npm run audit && npm run eslint && npm run typecheck && npm run test && npm run package"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "powerbi-models": "2.1.1",
    "powerbi-visuals-api": "5.11.1",
    "powerbi-visuals-utils-formattingmodel": "6.0.4",
    "powerbi-visuals-utils-formattingutils": "6.1.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "eslint": "10.8.0",
    "eslint-plugin-powerbi-visuals": "1.1.1",
    "happy-dom": "20.11.0",
    "less": "^4.5.1",
    "powerbi-visuals-tools": "7.2.0",
    "typescript": "5.5.4",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
